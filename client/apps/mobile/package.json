{
  "name": "@kuaixie/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:h5": "uni --host 0.0.0.0 --port 5175",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin && node ../../scripts/verify-wechat-output.mjs --mode build --sync-config",
    "dev:app": "uni -p app",
    "build:app": "uni build -p app",
    "predev:h5": "node ../../scripts/ensure-hbuilderx-compiler.mjs --check",
    "prebuild:h5": "node ../../scripts/ensure-hbuilderx-compiler.mjs --check",
    "predev:mp-weixin": "node ../../scripts/ensure-hbuilderx-compiler.mjs --check",
    "prebuild:mp-weixin": "node ../../scripts/ensure-hbuilderx-compiler.mjs --check",
    "predev:app": "node ../../scripts/ensure-hbuilderx-compiler.mjs --check",
    "prebuild:app": "node ../../scripts/ensure-hbuilderx-compiler.mjs --check"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030320261023001",
    "@dcloudio/uni-app-plus": "3.0.0-5030320261023001",
    "@dcloudio/uni-components": "3.0.0-5030320261023001",
    "@dcloudio/uni-h5": "3.0.0-5030320261023001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030320261023001",
    "@kuaixie/i18n": "workspace:*",
    "@kuaixie/preferences": "workspace:*",
    "@kuaixie/sdk": "workspace:*",
    "@kuaixie/ui": "workspace:*",
    "pinia": "^2.3.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.30",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030320261023001",
    "typescript": "~5.9.3",
    "vite": "5.2.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
