  <profiles>
    <!-- The imported com.kuaixie.market tests reference an implementation absent from
         this repository. Keep the default test run unchanged so that failure stays visible.
         This explicit profile runs tests of the current com.kuaixietech application. -->
    <profile>
      <id>current-app-tests</id>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration><testIncludes><testInclude>com/kuaixietech/**/*.java</testInclude></testIncludes></configuration>
      </plugin></plugins></build>
    </profile>
  </profiles>
